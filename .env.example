# DUAL BOTS / SERVER ONLY. Copy to .env; NEVER commit .env.
ZVEZDOCHKA_IMAGE=ghcr.io/batonsex228-cyber/tg-zvezda-promo:zvezdochka-latest
TOURIST_IMAGE=ghcr.io/batonsex228-cyber/tg-zvezda-promo:tourist-latest

# TWO DIFFERENT @BotFather BOT TOKENS
ZVEZDOCHKA_BOT_TOKEN=
TOURIST_BOT_TOKEN=

# Shared Telegram API HTTPS relay (Cloudflare Worker).
# This is an API proxy, NOT a HTTPS_PROXY / VPN endpoint.
TELEGRAM_API_BASE_URL=https://telegram-api-proxy.aleksejnazarov93583.workers.dev
# Use only if your Worker enforces X-Relay-Key; do not put it in Git.
TELEGRAM_RELAY_KEY=

# Essential admin IDs; /id for Zvezdochka and Tourist.
ZVEZDOCHKA_MANAGER_ID=0
TOURIST_OWNER_ID=

# Tourist Mini App MUST have a public domain with HTTPS (DNS A to server).
TOURIST_DOMAIN=
TOURIST_SHOWCASE_MODE=true
TOURIST_BACKUP_INTERVAL_HOURS=24
TOURIST_BACKUP_KEEP_DAYS=14
TOURIST_REMINDER_HOURS_BEFORE=0
TOURIST_GOOGLE_SHEET_ID=
TOURIST_GOOGLE_CREDENTIALS_FILE=
TOURIST_AI_MODE=off

# Zvezdochka optional features; no Google backend by default.
ZVEZDOCHKA_BOOKINGS_ENABLED=false
ZVEZDOCHKA_BOOKING_API_URL=
ZVEZDOCHKA_BOOKING_API_SECRET=
ZVEZDOCHKA_SHIFT_BOOKINGS_ENABLED=true
ZVEZDOCHKA_SHIFT_EXPORT_PII_TO_GOOGLE=false
ZVEZDOCHKA_SHIFT_ACTIVE_NUMBERS=1,2,3,4
ZVEZDOCHKA_AUTO_REFRESH_KB=false
ZVEZDOCHKA_OPENAI_API_KEY=
