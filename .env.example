# Required, created by START_TELEGRAM.bat
TELEGRAM_BOT_TOKEN=

# Optional. Get via /id in private chat after /start, then restart.
TELEGRAM_MANAGER_USER_ID=0

# AI optional. Without API key bot answers from FAQ and routes unknowns to manager.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Google booking requires Apps Script. Shift forms work locally with a manager ID, without Google.
BOOKINGS_ENABLED=false
BOOKING_API_URL=
BOOKING_API_SECRET=
SMART_HANDOFF_ENABLED=true
KNOWLEDGE_LOOP_ENABLED=true
SHIFT_BOOKINGS_ENABLED=true
SHIFT_PRIVACY_POLICY_URL=https://zvezdaglazov.ru/pages/parents.html
SHIFT_ACTIVE_NUMBERS=1,2,3,4
SHIFT_EXPORT_PII_TO_GOOGLE=false

AUTO_REFRESH_KB=true
SITE_URL=https://zvezdaglazov.ru/

# Docker/GHCR only (replace OWNER with your GitHub login):
BOT_IMAGE=ghcr.io/OWNER/zvezdochka-telegram-bot:latest
