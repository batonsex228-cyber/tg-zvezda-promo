# Только для compose.offsite.yaml. Скопируйте как offsite.env на VPS.
OFFSITE_S3_BUCKET=
OFFSITE_S3_PREFIX=tourist/
OFFSITE_S3_REGION=
# Только https://; пусто для AWS S3.
OFFSITE_S3_ENDPOINT_URL=
OFFSITE_INTERVAL_HOURS=24
# Используйте ограниченного IAM-пользователя / S3 key с доступом ТОЛЬКО к bucket/prefix.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
