# Создайте собственного тестового бота через @BotFather. Токен никому не отправляйте.
BOT_TOKEN=
# Укажите HTTPS-адрес работающего сервера Mini App (не localhost)
WEBAPP_URL=
# Ваш личный Telegram ID (число). Он станет владельцем админки.
OWNER_TELEGRAM_ID=0
DATABASE_PATH=data/tourist.sqlite3
CLUB_TIMEZONE=Europe/Moscow
# Локальный просмотр без токена, ТОЛЬКО для разработки на 127.0.0.1
DEMO_MODE=false
# Стартовое наполнение расписания. Значение true создаёт 3 примера событий в новой базе; выключайте при подключении календаря реального клуба.
SHOWCASE_MODE=true
# Заполните оба поля, когда подключите Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=
SYNC_INTERVAL_SECONDS=45

# Напоминания гостям за N часов до игры/бронирования. 0 = отключены.
# До согласования с клиентом оставьте 0. Допустимые значения 1–168.
REMINDER_HOURS_BEFORE=0

# Автокопии SQLite: первые через 30 сек после старта, далее проверка каждый час.
# 0 = отключены. Ручные копии BACKUP_WINDOWS.bat не удаляются автоматически.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Только для Docker Compose/Linux VPS: публичный домен без https://
# На Windows эта настройка не нужна.
DOMAIN=

# Необязательный локальный AI для свободных вопросов. По умолчанию выключен.
# Установите Ollama, загрузите модель отдельно, затем включите режим.
AI_MODE=off
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
